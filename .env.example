# Export these in the backend process for local development.
HOST=127.0.0.1
PORT=5000
# Omit to deny cross-origin browser access. Use exact comma-separated origins.
PARTNER_CORS_ORIGINS=http://localhost:3000
# Optional operator-controlled paths. Prefer absolute paths.
# PARTNER_DATA_DIR=C:/path/to/artifacts
# PARTNER_MODEL_PATH=C:/path/to/local/sentence-transformer

# Recommendation admission budgets per minute and concurrent computations.
# PARTNER_REQUESTS_PER_MINUTE=120
# PARTNER_BIO_REQUESTS_PER_MINUTE=30
# PARTNER_MAX_CONCURRENT=2
# Set one private local path shared by all WSGI workers on this host.
# PARTNER_LIMITS_DB=C:/path/to/private-state/recommendation-limits.sqlite3
